# The published state of tests/data/similarity-duplicates.ttl.
#
# similarity-duplicates.ttl adds 0000002, 0000003 and 0000004 to it, so a
# `compare` of the two screens exactly those three additions.

@prefix ex: <https://example.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

ex:0000010 a skos:Concept ;
    skos:prefLabel "synthesis method"@en ;
    skos:definition "A procedure by which a material is produced."@en ;
    skos:topConceptOf <https://example.org/> .

ex:0000011 a skos:Concept ;
    skos:prefLabel "preparation"@en ;
    skos:definition "The act of making something ready for use."@en ;
    skos:broader ex:0000010, ex:0000012 .

ex:0000012 a skos:Concept ;
    skos:prefLabel "processing"@en ;
    skos:definition "A series of operations applied to a material."@en ;
    skos:broader ex:0000010 .

ex:0000001 a skos:Concept ;
    skos:prefLabel "co-precipitation"@en ;
    skos:definition "Precipitation of more than one substance at the same time from a common solution."@en ;
    skos:broader ex:0000010 .
